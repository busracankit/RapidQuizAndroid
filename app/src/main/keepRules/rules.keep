# Rapid Quiz — R8 kuralları
# AGP, src/main/keepRules altındaki bütün dosyaları R8'e verir.
#
# Not: build.gradle.kts'deki optimization.packageScope şu an yalnızca androidx/kotlin/kotlinx
# paketlerini optimize ediyor; uygulama kodu ve Retrofit/OkHttp dokunulmadan kalıyor.
# Aşağıdaki kurallar packageScope genişletildiğinde (ya da kaldırıldığında) güvenli kalmak için.

# Yansıma ile okunan imzalar ve ek açıklamalar (Retrofit suspend + generic dönüş tipleri)
-keepattributes Signature, InnerClasses, EnclosingMethod, RuntimeVisibleAnnotations, RuntimeVisibleParameterAnnotations, AnnotationDefault

# Retrofit API arayüzü
-keep,allowobfuscation interface com.busracankit.rapidquiz.data.api.RapidQuizApi

# kotlinx.serialization: API modelleri ve tip güvenli navigasyon rotaları
-keep,includedescriptorclasses class com.busracankit.rapidquiz.**$$serializer { *; }
-keepclassmembers @kotlinx.serialization.Serializable class com.busracankit.rapidquiz.** {
    *** Companion;
    *** INSTANCE;
    kotlinx.serialization.KSerializer serializer(...);
}
-keepclassmembers class com.busracankit.rapidquiz.**$Companion {
    kotlinx.serialization.KSerializer serializer(...);
}
